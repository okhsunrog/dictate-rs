[Desktop Entry]
Type=Application
Name=Dictate
Comment=Voice dictation with transcription and text editing
Exec=dictate
TryExec=dictate
Icon=audio-input-microphone
Categories=Utility;AudioVideo;
Keywords=voice;dictation;speech;
StartupNotify=false
Actions=Compact;Settings;Review;

[Desktop Action Compact]
Name=Open compact bar
Exec=dictate compact

[Desktop Action Settings]
Name=Settings
Exec=dictate settings

[Desktop Action Review]
Name=Open editor
Exec=dictate show
